#!/bin/sh
# The rest of the guest's init, from the agent disk, which the image's stub init
# (surogate-init) mounted at /run/surogate/agent. It ends by running the agent
# under tini, which reaps orphans. When the agent exits, so does tini, PID 1, and
# the guest panics, which ends QEMU (panic=-1, -no-reboot).
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# The sessions disk holds each root's home and temp folder, which can be lost.
# It is made, empty, when it holds no ext4 superblock yet: its first boot. At
# every later boot it is checked and repaired, and made again only when the
# repair leaves errors (e2fsck's exit code 4, without 8 or more). Any other
# failure, such as a feature this e2fsck does not know, stops the boot and
# leaves the homes on the disk as they are.
if [ "$(od -An -tx2 -j1080 -N2 /dev/vdc)" != " ef53" ]; then
  mke2fs -q -F -t ext4 -E nodiscard -L sessions /dev/vdc
else
  checked=0
  e2fsck -p /dev/vdc || checked=$?
  if [ "$checked" -ge 4 ]; then
    checked=0
    e2fsck -y /dev/vdc || checked=$?
  fi
  if [ "$checked" -ge 8 ]; then
    echo "surogate: e2fsck could not check the sessions disk (exit code $checked), so the guest stops and leaves it as it is" >&2
    exit 1
  fi
  [ "$checked" -lt 4 ] || mke2fs -q -F -t ext4 -E nodiscard -L sessions /dev/vdc
fi
mkdir -p /run/surogate/sessions
mount -t ext4 -o nodev,nosuid,discard /dev/vdc /run/surogate/sessions
mkdir -p -m 0711 /run/surogate/sessions/roots

modprobe virtiofs
modprobe overlay
# The kernel loads no more modules: a command opening a socket of a rare family
# would otherwise pull that family's code into the kernel every root shares.
echo 1 > /proc/sys/kernel/modules_disabled
# No user namespaces in the guest: the agent makes the roots' namespaces as root.
echo 0 > /proc/sys/user/max_user_namespaces
# What systemd's sysctl files set on a host, which the guest has none of, and no
# io_uring, a large interface every root would share.
sysctl -q -w kernel.kptr_restrict=2 kernel.dmesg_restrict=1 kernel.kexec_load_disabled=1 \
  kernel.unprivileged_bpf_disabled=1 net.core.bpf_jit_harden=2 \
  fs.protected_symlinks=1 fs.protected_hardlinks=1 fs.protected_fifos=1 fs.protected_regular=2 \
  kernel.io_uring_disabled=2

# The kernel sizes its task limit to the guest's memory: 15 665 for 2 GiB, below
# four roots at their own bound, so the roots together would reach it before their
# cgroup's and leave the agent no process to start. Each task's kernel stack and
# task_struct are charged to its memory cgroup, so the roots' memory.max still
# bounds what their tasks cost, and pid_max's 32 768 is the guest's limit.
sysctl -q -w kernel.threads-max=32768

# Each root in a cgroup of its own (root.ts), under one whose memory stops 256 MiB
# short of the guest's and whose processes stop 4096 short of its 32 768, so the
# roots together cannot take the agent's memory or leave it no process to start.
# The agent stays in the top cgroup, where the cpu controller gives it a share
# against all the roots together, and it is the last the kernel would end for memory.
mount -t cgroup2 -o nosuid,nodev,noexec cgroup2 /sys/fs/cgroup
echo "+cpu +memory +pids" > /sys/fs/cgroup/cgroup.subtree_control
mkdir /sys/fs/cgroup/roots
echo "+memory +pids" > /sys/fs/cgroup/roots/cgroup.subtree_control
total=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
echo $(( (total - 262144) * 1024 )) > /sys/fs/cgroup/roots/memory.max
echo 28672 > /sys/fs/cgroup/roots/pids.max
echo -1000 > /proc/self/oom_score_adj

# The guest-kernel rule on protected names (rule.bpf.c), loaded before any session.
# A session (uid >= 10000) cannot unload it: unprivileged_bpf_disabled=1 is set above.
mount -t securityfs -o nosuid,nodev,noexec securityfs /sys/kernel/security
mount -t bpf -o nosuid,nodev,noexec bpf /sys/fs/bpf
mkdir -p /sys/fs/bpf/surogate
grep -qw bpf /sys/kernel/security/lsm || { echo "surogate: the bpf LSM is not active; refusing to run commands unprotected" >&2; exit 1; }
/usr/sbin/bpftool prog loadall /usr/lib/surogate/rule.bpf.o /sys/fs/bpf/surogate autoattach \
  || { echo "surogate: could not load the guest-kernel protected-names rule" >&2; exit 1; }
want=11 # the rule's lsm programs; a host test keeps this in step with rule.bpf.c
# grep -c exits 1 on a count of 0, which set -e would end on without saying why.
have=$(/usr/sbin/bpftool link show | grep -c lsm || true)
[ "$have" = "$want" ] || { echo "surogate: the protected-names rule attached $have of $want hooks" >&2; exit 1; }
echo "surogate: the protected-names rule attached $have of $want hooks, under the LSMs $(cat /sys/kernel/security/lsm)"

exec /usr/bin/tini -- /usr/bin/node /run/surogate/agent/guest/agent.js
