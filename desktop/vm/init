#!/bin/sh
# The rest of the guest's init, from the agent disk, which the image's stub init
# (surogate-init) mounted at /run/surogate/agent. It ends by running the agent
# under tini, which reaps orphans. When the agent exits, so does tini, PID 1, and
# the guest panics, which ends QEMU (panic=-1, -no-reboot).
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# What systemd's sysctl files set on a host, which the guest has none of, and no
# io_uring, a large interface every root would share. First: the rule below loads under them.
sysctl -q -w kernel.kptr_restrict=2 kernel.dmesg_restrict=1 kernel.kexec_load_disabled=1 \
  kernel.unprivileged_bpf_disabled=1 net.core.bpf_jit_harden=2 \
  fs.protected_symlinks=1 fs.protected_hardlinks=1 fs.protected_fifos=1 fs.protected_regular=2 \
  kernel.io_uring_disabled=2

# The guest-kernel rule on protected names (rule.bpf.c), loaded beside the rest of the
# boot: bpftool takes about a second, and the sessions disk's check, the cgroups and the
# agent's start go on meanwhile. Its outcome lands in /run/surogate/rule, and the agent
# says hello only once that says the rule is attached (guest/agent.ts): no session runs
# before it, and a rule that does not load still fails the boot. A session (uid >= 10000,
# or the scope's uid) cannot unload it: unprivileged_bpf_disabled=1 is set above.
mount -t securityfs -o nosuid,nodev,noexec securityfs /sys/kernel/security
mount -t bpf -o nosuid,nodev,noexec bpf /sys/fs/bpf
mkdir -p /sys/fs/bpf/surogate /sys/fs/bpf/surogate-maps
want=15 # the rule's lsm programs; a host test keeps this in step with rule.bpf.c

# The rule's scope (rule.bpf.c, scope): the one uid it judges besides those from 10000 up, as the
# kernel's command line, given as $1, names it in surogate.uid=. A VM whose shares map no owner to
# a session's uid names the host user's (src/vm/darwin.ts), and every session there runs as it;
# Linux's names none. Printed, or nothing for none. Refused, with why printed: a uid no session
# may run as (0, the guest's own root; 4294967295, which is no uid), and a second surogate.uid=.
scope_uid() {
  found=
  set -f
  # shellcheck disable=SC2086 # split into words, never into files
  set -- $1
  set +f
  for word; do
    case "$word" in
      surogate.uid=*)
        [ -z "$found" ] || { echo "the kernel's command line names surogate.uid= twice"; return 1; }
        found=${word#surogate.uid=}
        case "$found" in
          '' | *[!0-9]* | 0*) echo "surogate.uid=$found is not a uid a session may run as"; return 1 ;;
        esac
        { [ "${#found}" -le 10 ] && [ "$found" -le 4294967294 ]; } || { echo "surogate.uid=$found is not a uid a session may run as"; return 1; }
        ;;
    esac
  done
  echo "$found"
}
# A uid as the map takes it: its four bytes, the low first.
le32() {
  echo "$(($1 & 255)) $(($1 >> 8 & 255)) $(($1 >> 16 & 255)) $(($1 >> 24 & 255))"
}
(
  if ! grep -qw bpf /sys/kernel/security/lsm; then
    echo "failed: the bpf LSM is not active; refusing to run commands unprotected"
  elif ! scope=$(scope_uid "$(cat /proc/cmdline)"); then
    echo "failed: $scope"
  elif ! /usr/sbin/bpftool prog loadall /usr/lib/surogate/rule.bpf.o /sys/fs/bpf/surogate pinmaps /sys/fs/bpf/surogate-maps autoattach >&2; then
    echo "failed: could not load the guest-kernel protected-names rule"
  # Its scope set, then frozen before any session runs: nothing, the agent included, changes it after.
  # The agent runs every session as it, where it is set (guest/root.ts).
  # shellcheck disable=SC2046 # four bytes, four words
  elif ! { /usr/sbin/bpftool map update pinned /sys/fs/bpf/surogate-maps/scope key 0 0 0 0 value $(le32 "${scope:-0}") \
      && /usr/sbin/bpftool map freeze pinned /sys/fs/bpf/surogate-maps/scope && echo "$scope" > /run/surogate/scope; } >&2; then
    echo "failed: could not set the protected-names rule's scope"
  else
    # grep -c exits 1 on a count of 0, which would end this without a word.
    have=$(/usr/sbin/bpftool link show | grep -c lsm || true)
    if [ "$have" = "$want" ]; then
      echo "attached: the protected-names rule attached $have of $want hooks, under the LSMs $(cat /sys/kernel/security/lsm)"
    else
      echo "failed: the protected-names rule attached $have of $want hooks"
    fi
  fi > /run/surogate/rule.partial
  mv /run/surogate/rule.partial /run/surogate/rule
) &

# The guest's disk of the role $2 (1, the agent disk; 2, the sessions disk), on the bus the kernel's
# command line, $1, names in surogate.disks=: virtio's by its name, vd<letter> in the disks' order; SCSI's
# by its LUN, the one disk whose address under $3/class/scsi_disk ends :0:0:<role>, there being no udev
# to name it. Printed, or why not. Refused: a line that names no bus, two, or one this guest does not
# know. The image's stub init (images/guest/surogate-init) holds the same function, which a host test
# keeps the same.
disk() {
  bus=
  set -f
  # shellcheck disable=SC2086 # split into words, never into files
  for word in $1; do
    case "$word" in
      surogate.disks=*)
        [ -z "$bus" ] || { set +f; echo "the kernel's command line names surogate.disks= twice"; return 1; }
        bus=${word#surogate.disks=}
        ;;
    esac
  done
  set +f
  case "$bus" in
    virtio)
      case "$2" in
        1) echo /dev/vdb ;;
        2) echo /dev/vdc ;;
        *) echo "the guest has no disk of role $2"; return 1 ;;
      esac
      ;;
    scsi)
      found=
      for address in "$3"/class/scsi_disk/*:0:0:"$2"; do
        [ -e "$address" ] || continue
        [ -z "$found" ] || { echo "two SCSI disks are at LUN $2"; return 1; }
        found=$address
      done
      [ -n "$found" ] || { echo "no SCSI disk is at LUN $2"; return 1; }
      for block in "$found"/device/block/*; do
        [ -e "$block" ] || break
        echo "/dev/${block##*/}"
        return 0
      done
      echo "the SCSI disk at LUN $2 has no block device"
      return 1
      ;;
    '') echo "the kernel's command line names no surogate.disks="; return 1 ;;
    *) echo "surogate.disks=$bus is not a bus this guest knows"; return 1 ;;
  esac
}

# The sessions disk holds each root's home and temp folder, which can be lost.
# It is made, empty, when it holds no ext4 superblock yet: its first boot. At
# every later boot it is checked and repaired, and made again only when the
# repair leaves errors (e2fsck's exit code 4, without 8 or more). Any other
# failure, such as a feature this e2fsck does not know, stops the boot and
# leaves the homes on the disk as they are: the app keeps that disk aside, by
# this line on the console, and boots again on a new one (vm/manager.ts).
sessions=$(disk "$(cat /proc/cmdline)" 2 /sys) || { echo "surogate: $sessions, so the guest stops" >&2; exit 1; }
if [ "$(od -An -tx2 -j1080 -N2 "$sessions")" != " ef53" ]; then
  mke2fs -q -F -t ext4 -E nodiscard -L sessions "$sessions"
else
  checked=0
  e2fsck -p "$sessions" || checked=$?
  if [ "$checked" -ge 4 ]; then
    checked=0
    e2fsck -y "$sessions" || checked=$?
  fi
  if [ "$checked" -ge 8 ]; then
    echo "surogate: e2fsck could not check the sessions disk (exit code $checked), so the guest stops; the app keeps the disk aside and makes a new one" >&2
    exit 1
  fi
  [ "$checked" -lt 4 ] || mke2fs -q -F -t ext4 -E nodiscard -L sessions "$sessions"
fi
mkdir -p /run/surogate/sessions
mount -t ext4 -o nodev,nosuid,discard "$sessions" /run/surogate/sessions
mkdir -p -m 0711 /run/surogate/sessions/roots

modprobe virtiofs
modprobe overlay
# The kernel loads no more modules: a command opening a socket of a rare family
# would otherwise pull that family's code into the kernel every root shares.
echo 1 > /proc/sys/kernel/modules_disabled
# No user namespaces in the guest: the agent makes the roots' namespaces as root.
echo 0 > /proc/sys/user/max_user_namespaces

# The kernel sizes its task limit to the guest's memory: 15 665 for 2 GiB, below
# four roots at their own bound, so the roots together would reach it before their
# cgroup's and leave the agent no process to start. Each task's kernel stack and
# task_struct are charged to its memory cgroup, so the roots' memory.max still
# bounds what their tasks cost, and pid_max's 32 768 is the guest's limit.
sysctl -q -w kernel.threads-max=32768

# Each root in a cgroup of its own (root.ts), under one whose memory stops 256 MiB
# short of the guest's and whose processes stop 4096 short of its 32 768, so the
# roots together cannot take the agent's memory or leave it no process to start.
# The agent stays in the top cgroup, where the cpu controller gives it a share
# against all the roots together, and it is the last the kernel would end for memory.
mount -t cgroup2 -o nosuid,nodev,noexec cgroup2 /sys/fs/cgroup
echo "+cpu +memory +pids" > /sys/fs/cgroup/cgroup.subtree_control
mkdir /sys/fs/cgroup/roots
echo "+memory +pids" > /sys/fs/cgroup/roots/cgroup.subtree_control
total=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
echo $(( (total - 262144) * 1024 )) > /sys/fs/cgroup/roots/memory.max
echo 28672 > /sys/fs/cgroup/roots/pids.max
echo -1000 > /proc/self/oom_score_adj

exec /usr/bin/tini -- /usr/bin/node /run/surogate/agent/guest/agent.js
